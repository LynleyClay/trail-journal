# Credentials for the admin panel (/admin/*) and any content-mutating API
# requests (POST/PUT/DELETE). Reads (home, map, individual posts) stay public.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Cloudflare R2 (S3-compatible object storage). When all five are set,
# uploaded photos and post data are stored in R2 so the admin panel works in
# production (the deployed filesystem is read-only). When unset, everything
# falls back to the local content/ and public/photos/ directories for local
# development.
#
# R2_ACCOUNT_ID / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY come from an R2 API
# token scoped to Object Read & Write on your bucket (Cloudflare dashboard ->
# R2 Object Storage -> Manage R2 API Tokens).
# R2_BUCKET_NAME is the bucket you created.
# R2_PUBLIC_URL is the bucket's public r2.dev URL (enable it under the
# bucket's Settings -> Public Access), e.g. https://pub-xxxxxxxx.r2.dev
# R2_ENDPOINT is the S3-compatible endpoint shown when creating the API
# token, e.g. https://<account-id>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_ENDPOINT=
